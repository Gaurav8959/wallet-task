{
  "name": "wallet-task",
  "version": "1.0.0",
  "description": "Wallet transaction and transfer module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "cross-env nodemon --exec npx ts-node server/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server/index.js",
    "migration:create": "typeorm migration:create",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d ./server/data-source/data-source.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d ./server/data-source/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d ./dist/server/data-source/data-source.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-joi-validation": "^5.0.1",
    "http-status-codes": "^1.3.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.9.1",
    "mysql2": "^3.9.7",
    "reflect-metadata": "^0.2.1",
    "typeorm": "^0.3.19"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.9",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.2",
    "@types/node": "^20.10.7",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
